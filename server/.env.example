# Samurai di Avakin - Configurazione ambiente
# Copia questo file in .env e modifica i valori

# ============================================
# AMBIENTE
# ============================================
# Valori: development, production, test
NODE_ENV=development

# ============================================
# SERVER
# ============================================
# Indirizzo e porta del server
HOST=127.0.0.1
PORT=4173

# ============================================
# DATABASE
# ============================================
# Per PGlite (default, zero configurazione):
# DATABASE_URL=pglite://

# Per PostgreSQL:
# DATABASE_URL=postgres://username:password@localhost:5432/samurai

# ============================================
# JWT / AUTENTICAZIONE
# ============================================
# Segreto per JWT - CAMBIA IN PRODUZIONE!
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=il_tuo_segreto_jwt_qui_sostituire_con_un_valore_sicuro

# Nome cookie di sessione
COOKIE_NAME=samurai_session

# TTL access token (minuti)
JWT_ACCESS_TTL=20

# Durata refresh token (giorni)
JWT_REFRESH_DAYS=30

# ============================================
# UPLOAD
# ============================================
# Cartella upload
UPLOAD_DIR=server/uploads

# Max dimensione file (byte)
UPLOAD_MAX_BYTES=4194304  # 4MB

# ============================================
# CORS
# ============================================
# Origini consentite per CORS (separate da virgola)
# Esempio: http://localhost:3000,https://tuosito.it
# Lascia vuoto per disabilitare CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# ============================================
# WEB PUSH NOTIFICATIONS (VAPID)
# ============================================
# Chiavi VAPID per notifiche push
# Genera con: openssl ecparam -name prime256v1 -genkey -noout -out vapid_private.pem
#                           openssl ec -in vapid_private.pem -pubout -out vapid_public.pem
# Poi estrai le chiavi con: node -e "console.log(require('fs').readFileSync('vapid_public.pem','utf8').trim())"
VAPID_PUBLIC_KEY=il_tuo_public_key_vapid_qui
VAPID_PRIVATE_KEY=il_tuo_private_key_vapid_qui
VAPID_SUBJECT=mailto:admin@tuosito.it

# ============================================
# LOGGING
# ============================================
# Livello di log (error, warn, info, debug)
LOG_LEVEL=info

# ============================================
# EMAIL (SMTP per verifica e reset password)
# ============================================

# ============================================
# PRODUZIONE
# ============================================
# In produzione, assicurati che:
# - JWT_SECRET sia forte
# - DATABASE_URL punti a PostgreSQL
# - VAPID keys siano configurate
# - NODE_ENV=production
# - HOST e PORT siano configurati per il dominio

# ============================================
# DEVELOPMENT
# ============================================
# In sviluppo puoi usare:
# - PGlite come database (zero configurazione)
# - CORS abilitati per localhost
# - Token reset password visibili nella risposta

# ============================================
# TEST
# ============================================
# Per eseguire test:
# TEST_PORT=4174  # Porta usata per test
# TEST_TIMEOUT=30000  # Timeout in ms

# ============================================
# LOGIN SOCIAL — Google, Microsoft, Apple
# ============================================
# SOCIAL_DEV_MODE=true (default): il social login funziona in modalità
# dev senza credenziali reali. In produzione imposta false e configura
# le credenziali OAuth vere di ogni provider.
SOCIAL_DEV_MODE=true

# ============================================
# ANTI-BOT (Cloudflare Turnstile)
# ============================================
# Attiva la protezione anti-bot sulla registrazione.
# TURNSTILE_ENABLED=false
# TURNSTILE_SITE_KEY=il_tuo_site_key
# TURNSTILE_SECRET=il_tuo_secret_key

# Età minima per la registrazione (anni)
MIN_AGE=13

# Google Cloud Console > Credentials > OAuth client ID (tipo applicazione web)
# Redirect URI: https://tuodominio.it/api/auth/social/google/callback
GOOGLE_CLIENT_ID=il_tuo_google_client_id
GOOGLE_CLIENT_SECRET=il_tuo_google_client_secret
GOOGLE_REDIRECT_URI=https://tuodominio.it/api/auth/social/google/callback

# Microsoft Entra ID (Azure AD) > App registrazioni > Auth
# Redirect URI: https://tuodominio.it/api/auth/social/microsoft/callback
MICROSOFT_CLIENT_ID=il_tuo_microsoft_client_id
MICROSOFT_CLIENT_SECRET=il_tuo_microsoft_client_secret
MICROSOFT_REDIRECT_URI=https://tuodominio.it/api/auth/social/microsoft/callback

# Apple > Identifiers > Services ID + Keys > Auth Key (.p8)
# Redirect URI: https://tuodominio.it/api/auth/social/apple/callback
APPLE_CLIENT_ID=il_tuo_apple_services_id
APPLE_TEAM_ID=il_tuo_team_id
APPLE_KEY_ID=il_tuo_key_id
APPLE_REDIRECT_URI=https://tuodominio.it/api/auth/social/apple/callback
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# =============================================================================
# SAMURAI DI AVAKIN - CONFIGURAZIONE SERVER
# =============================================================================
# Copia questo file in server/.env e modifica i valori per il tuo ambiente
# =============================================================================

# -----------------------------------------------------------------------------
# AMBIENTE
# -----------------------------------------------------------------------------
NODE_ENV=development
# NODE_ENV=production

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
PORT=4173
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Sviluppo: PGlite (file locale, nessun server PostgreSQL necessario)
# PGLITE_DIR=./server/.data

# Produzione: PostgreSQL reale (commenta PGLITE_DIR e usa DATABASE_URL)
# DATABASE_URL=postgresql://user:password@localhost:5432/samurai
# DATABASE_SSL=false
# DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# AUTENTICAZIONE JWT
# -----------------------------------------------------------------------------
# GENERA IN PRODUZIONE: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-secret-change-in-production-min-32-chars

# -----------------------------------------------------------------------------
# COOKIE
# -----------------------------------------------------------------------------
COOKIE_NAME=sam_session
COOKIE_SECURE=false
# COOKIE_DOMAIN=tuodominio.it
COOKIE_SAME_SITE=lax

# Token duration
ACCESS_TTL=20m
REFRESH_DAYS=30

# -----------------------------------------------------------------------------
# EMAIL / SMTP
# -----------------------------------------------------------------------------
# Sviluppo: Ethereal Email (automatico, gratuito) - NON serve configurare nulla
# Produzione: Configura SMTP reale

# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM="Samurai di Avakin <noreply@tuodominio.it>"
# SMTP_FROM_NAME=Samurai di Avakin

# Alternative providers:
# Mailgun:    SMTP_HOST=smtp.mailgun.org        SMTP_PORT=587
# Postmark:   SMTP_HOST=smtp.postmarkapp.com    SMTP_PORT=587
# Brevo:      SMTP_HOST=smtp-relay.brevo.com    SMTP_PORT=587
# Resend:     SMTP_HOST=smtp.resend.com         SMTP_PORT=587
# Gmail:      SMTP_HOST=smtp.gmail.com          SMTP_PORT=587  (richiede App Password)

# -----------------------------------------------------------------------------
# CORS / ORIGIN
# -----------------------------------------------------------------------------
# Sviluppo: vuoto = stesso origine (porta 4173)
# Produzione: lista domini separati da virgola
CORS_ORIGINS=https://tuodominio.it,https://www.tuodominio.it
PUBLIC_ORIGIN=https://tuodominio.it

# -----------------------------------------------------------------------------
# UPLOAD FILE
# -----------------------------------------------------------------------------
UPLOAD_MAX_BYTES=4194304
ALLOW_IMAGE_ONLY=true

# -----------------------------------------------------------------------------
# OAUTH SOCIAL (opzionale)
# -----------------------------------------------------------------------------
# Google
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx
# GOOGLE_REDIRECT_URI=https://tuodominio.it/api/auth/social/google/callback

# Microsoft
# MICROSOFT_CLIENT_ID=xxx
# MICROSOFT_CLIENT_SECRET=xxx
# MICROSOFT_REDIRECT_URI=https://tuodominio.it/api/auth/social/microsoft/callback

# Apple
# APPLE_CLIENT_ID=xxx
# APPLE_TEAM_ID=xxx
# APPLE_KEY_ID=xxx
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_REDIRECT_URI=https://tuodominio.it/api/auth/social/apple/callback

# Modalità dev per OAuth (simula provider senza credenziali reali)
SOCIAL_DEV_MODE=true

# -----------------------------------------------------------------------------
# ANTI-BOT (Cloudflare Turnstile) - opzionale
# -----------------------------------------------------------------------------
# TURNSTILE_SECRET=0x4AAAAAAAxxx
# TURNSTILE_SITE_KEY=0x4AAAAAAAxxx
# TURNSTILE_ENABLED=false

# -----------------------------------------------------------------------------
# PUSH NOTIFICATIONS (Web Push / VAPID) - opzionale
# -----------------------------------------------------------------------------
# VAPID_PUBLIC_KEY=xxx
# VAPID_PRIVATE_KEY=xxx
# VAPID_SUBJECT=mailto:admin@tuodominio.it

# -----------------------------------------------------------------------------
# ETÀ MINIMA REGISTRAZIONE
# -----------------------------------------------------------------------------
MIN_AGE=13

# =============================================================================
# NOTE
# =============================================================================
# 1. Per sviluppo: NON serve toccare nulla, Ethereal Email funziona auto
# 2. Per produzione: imposta NODE_ENV=production e configura SMTP + JWT_SECRET
# 3. Non committare questo file con segreti reali (.gitignore incluso)
# =============================================================================
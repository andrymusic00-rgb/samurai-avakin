{
  "name": "samurai-di-avakin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Samurai di Avakin — sito del clan con auth reale, area account e area riservata",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/src/server.js",
    "dev": "node --watch server/src/server.js",
    "migrate": "node server/scripts/migrate.js",
    "seed": "node server/scripts/seed.js",
    "seed:reset": "node server/scripts/seed.js --reset",
    "reset": "node server/scripts/reset.js",
    "icons": "node server/scripts/icons.js",
    "check": "node --check server/src/server.js",
    "test": "node server/scripts/test.js all",
    "test:unit": "node server/scripts/test.js unit",
    "test:integration": "node server/scripts/test.js integration",
    "test:e2e": "node server/scripts/test.js e2e",
    "test:api": "node server/scripts/test.js api",
    "test:coverage": "node server/scripts/test.js all --coverage",
    "test:verbose": "node server/scripts/test.js all --verbose",
    "db:migrate": "node server/scripts/migrate.js",
    "db:seed": "node server/scripts/seed.js",
    "db:update": "node server/scripts/migrate.js server/db/schema_update.sql",
    "db:reset": "node server/scripts/reset.js",
    "cms:import": "node server/scripts/cmsImport.js",
    "cms:export": "node server/scripts/cmsExport.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/nodemailer": "^8.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  }
}
